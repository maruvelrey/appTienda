rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return signedIn() &&
        exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function validOrder(orderId) {
      let data = request.resource.data;
      return signedIn() &&
        data.keys().hasOnly([
          'code', 'customer', 'customerUid', 'payment', 'total', 'status',
          'items', 'stockChanges', 'createdAt'
        ]) &&
        data.code == '#SR-' + orderId &&
        data.customer is string &&
        data.customer.size() > 0 &&
        data.customer.size() <= 120 &&
        data.customerUid == request.auth.uid &&
        data.payment in [
          'Transferencia', 'Tarjeta (simulación)', 'Efectivo contra entrega'
        ] &&
        data.total is number &&
        data.total > 0 &&
        data.status == 'Pedido recibido' &&
        data.items is list &&
        data.items.size() > 0 &&
        data.items.size() <= 30 &&
        data.stockChanges is map &&
        data.stockChanges.size() > 0;
    }

    match /admins/{uid} {
      allow get: if signedIn() && request.auth.uid == uid;
      allow list, create, update, delete: if false;
    }

    match /products/{productId} {
      allow read: if true;
      allow create, delete: if isAdmin();
      allow update: if isAdmin() || (
        signedIn() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['stock', 'lastOrderId']) &&
        request.resource.data.stock is int &&
        request.resource.data.stock >= 0 &&
        request.resource.data.lastOrderId is string &&
        existsAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)
        ) &&
        getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)
        ).data.customerUid == request.auth.uid &&
        getAfter(
          /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)
        ).data.stockChanges[productId] is int &&
        request.resource.data.stock ==
          resource.data.stock -
          getAfter(
            /databases/$(database)/documents/orders/$(request.resource.data.lastOrderId)
          ).data.stockChanges[productId]
      );
    }

    match /orders/{orderId} {
      allow create: if validOrder(orderId);
      allow get, list: if isAdmin();
      allow update: if isAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['status']) &&
        request.resource.data.status in [
          'Pedido recibido', 'En preparación', 'Empacado', 'En ruta',
          'Entregado', 'Cancelado'
        ];
      allow delete: if false;
    }
  }
}
